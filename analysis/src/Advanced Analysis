--=============================================
-- ANALYSIS
--=============================================

--Change Over Time (Total_transactions, Total_clients, Total_amount)
select 
    to_char(transaction_date, 'mon') as month,
    count(*) as total_transactions,
    count(distinct account_id) as total_clients,
    round(sum(amount)) as total_amount
from gold.fact_transactions
where transaction_date is not null
group by 
    to_char(transaction_date, 'mon'),
    extract(month from transaction_date)
order by extract(month from transaction_date)

--Cumulative Analysis (Running_total_amount, Moving_average_transaction)
select
	transaction_month,
	round(total_amount::numeric,2),
	round(sum(total_amount::numeric) over(order by transaction_month),2) as running_total_amount,
	round(avg(avg_amount::numeric) over(order by transaction_month),2) as moving_avg
from(
select 
	date_trunc('month', transaction_date)::date as transaction_month,
	sum(amount) as total_amount,
	avg(amount) as avg_amount
from gold.fact_transactions
where transaction_date is not null
group by date_trunc('month', transaction_date)::date
order by date_trunc('month', transaction_date)::date
)t
order by transaction_month

--Loan Portfolio Health (Approval rate, Avg interest rate by credit band)
select 
	case
		when credit_score_at_application < 600 then 'Bellow 600'
		when credit_score_at_application between 600 and 699 then '600-699' 
		when credit_score_at_application between 700 and 749 then '700-749'
		else 'Above 750'
	end as credit_band,
	count(*) as total_applications,
	count(*) filter(where status = 'Approved') as total_approved,
	round(100.0 * count(*) filter(where status = 'Approved') / count(*),1) as approval_rate
from gold.fact_loans
where credit_score_at_application is not null
group by credit_band

--Branch Performance (Total_balance, Total_transaction_volume by branch)
select 
	b.branch_id,
	b.branch_name,
	b.city,
	count(distinct a.account_id) as total_accounts,
	round(sum(a.balance::numeric),2) as total_balance,
	round(sum(t.amount::numeric),2) as total_transaction_volume
from gold.dim_branches b
left join gold.dim_accounts a on b.branch_id = a.branch_id
left join gold.fact_transactions t on a.account_id = t.account_id
group by b.branch_id, b.branch_name, b.city

--Account Status Breakdown (Dormant/Frozen/Closed rate)
select
status,
count(*) as total_accounts,
round(100.0 * count(*) / sum(count(*)) over(), 1) as pct_of_total
from gold.dim_accounts
group by status
order by total_accounts desc

--Data Segmentation (Balance range)
with account_segment as (select
account_id,
balance,
case 
	when balance < 1000 then 'Bellow 1000'
	when balance between 1000 and 10000 then '1000-10,000'
	when balance between 10000 and 50000 then '10,000-50,000'
	else 'Above 50,000'
end as balance_range
from gold.dim_accounts
)
select 
balance_range,
count(account_id) as total_accounts
from account_segment
group by balance_range
order by total_accounts desc

--Data Quality (Orphaned transactions, Missing close dates)
select 'Orphaned transactions' as check_name,
round(100.0 * count(*) filter (where customer_id is null) / count(*), 2) as pct
from gold.fact_transactions
union all
select 'Closed accounts missing close_date',
round(100.0 * count(*) filter (where close_date is null) / count(*), 2)
from gold.dim_accounts
where status = 'closed'


create view gold.report_clients as
/*
============================================================================
Client Report
============================================================================
*/

with client_accounts as (
select
	customer_id as client_id,
	count(distinct account_id) as total_accounts,
	sum(balance) as total_balance,
	min(open_date) as first_account_date
from gold.dim_accounts
group by customer_id
),

client_transactions as (
select
	customer_id as client_id,
	count(distinct transaction_id) as total_transactions,
	round(sum(amount::numeric),2) as total_spent
from gold.fact_transactions
group by customer_id
),

client_loans as (
select
	customer_id as client_id,
	count(distinct loan_id) as total_loans,
	round(sum(amount_approved::numeric),2) as total_loan_approved
from gold.fact_loans
group by customer_id
),

client_base as (
select
	customer_id as client_id,
	first_name,
	last_name,
	extract(year from current_date) - extract(year from date_of_birth) as age
from gold.dim_customers
)

select
	b.client_id,
	b.first_name,
	b.last_name,
	b.age,
	case 
		 when b.age < 30 then 'Under 30'
		 when b.age between 30 and 44 then '30-44'
		 when b.age between 45 and 59 then '45-59'
		 else '60 and above'
	end as age_group,
	coalesce(ca.total_accounts, 0) as total_accounts,
	coalesce(ca.total_balance, 0) as total_balance,
	coalesce(ct.total_transactions, 0) as total_transactions,
	coalesce(ct.total_spent, 0) as total_spent,
	coalesce(cl.total_loans, 0) as total_loans,
	coalesce(cl.total_loan_approved, 0) as total_loan_approved,
	(extract(year from current_date) - extract(year from ca.first_account_date)) * 12
   + (extract(month from current_date) - extract(month from ca.first_account_date)) as tenure_months,
	case 
		 when (extract(year from current_date) - extract(year from ca.first_account_date)) * 12
   		+ (extract(month from current_date) - extract(month from ca.first_account_date)) >= 12
   		 and coalesce(ca.total_balance, 0) > 10000 then 'High Value'
         when (extract(year from current_date) - extract(year from ca.first_account_date)) * 12
   		+ (extract(month from current_date) - extract(month from ca.first_account_date)) >= 12
   		 and coalesce(ca.total_balance, 0) <= 10000 then 'Standard'
         else 'New'
	end as client_segment,
	--Average Transaction Value
	case 
		 when coalesce(ct.total_transactions, 0) = 0 then 0
		 else round(ct.total_spent / ct.total_transactions, 2)
	end as avg_transaction_value,
	--Average Monthly Spend
	round(case 
		 when coalesce(ca.total_accounts, 0) = 0 then 0
		 else coalesce(ct.total_spent, 0) / 
		 	nullif((extract(year from current_date) - extract(year from ca.first_account_date)) * 12
   			+ (extract(month from current_date) - extract(month from ca.first_account_date)), 0)
	end, 2) as avg_monthly_spend
from client_base b
left join client_accounts ca on b.client_id = ca.client_id
left join client_transactions ct on b.client_id = ct.client_id
left join client_loans cl on b.client_id = cl.client_id
